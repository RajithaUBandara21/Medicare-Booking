VITE_CLOUD_NAME=<your-cloudinary-cloud-name>
VITE_UPLOAD_PRESET_NAME=<your-cloudinary-unsigned-upload-preset>
# Base URL of the deployed BackEnd, e.g. https://your-api.onrender.com/api/v1
# Leave unset for local dev - it falls back to http://localhost:5000/api/v1
VITE_API_BASE_URL=<your-deployed-backend-url>/api/v1
